@PACKAGE_INIT@
# A package lookup named Crypto yields exactly one imported Salts::Crypto.
if(TARGET Salts::Crypto)
  get_target_property(_old_import Salts::Crypto IMPORTED)
  if(NOT _old_import)
    message(FATAL_ERROR "Salts::Crypto is already compiled by another owner")
  endif()
  get_target_property(_old_archive Salts::Crypto IMPORTED_LOCATION_RELEASE)
  get_target_property(_old_archive_base Salts::Crypto IMPORTED_LOCATION)
  if(NOT _old_archive AND NOT _old_archive_base)
    message(FATAL_ERROR "Existing Salts::Crypto has no verifiable static archive")
  endif()
  message(FATAL_ERROR "Salts::Crypto already loaded from another package; duplicate owner forbidden")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CryptoTargets.cmake")
get_target_property(_crypto_type Salts::Crypto TYPE)
get_target_property(_crypto_imported Salts::Crypto IMPORTED)
if(NOT _crypto_imported OR NOT _crypto_type STREQUAL "STATIC_LIBRARY")
  message(FATAL_ERROR "Crypto SDK must import exactly one static Salts::Crypto")
endif()
foreach(_forbidden IN ITEMS Salts::TLS Salts::TLSHost Salts::TLSCipherBIO Salts::CryptoProvider)
  if(TARGET "${_forbidden}")
    message(FATAL_ERROR "Split Crypto target forbidden: ${_forbidden}")
  endif()
endforeach()
unset(_crypto_type)
unset(_crypto_imported)
unset(_old_import)
unset(_old_archive)
unset(_old_archive_base)
unset(_forbidden)
check_required_components(Crypto)
