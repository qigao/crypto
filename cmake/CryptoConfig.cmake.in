@PACKAGE_INIT@
# Compatibility name for the SM3 C11 Provider v0.1. The only physical image
# is Salts::TLS (libcrypto_tls); this config never imports a second DSO.
include(CMakeFindDependencyMacro)
find_dependency(CryptoTLS 0.1 CONFIG)
if(NOT TARGET Salts::TLS OR NOT TARGET Salts::CryptoProvider)
  message(FATAL_ERROR "Salts::CryptoProvider must be the installed view of Salts::TLS")
endif()
get_target_property(_crypto_provider_kind Salts::CryptoProvider TYPE)
if(NOT _crypto_provider_kind STREQUAL "INTERFACE_LIBRARY")
  message(FATAL_ERROR "Salts::CryptoProvider must not own a second native image")
endif()
get_target_property(_crypto_provider_links Salts::CryptoProvider INTERFACE_LINK_LIBRARIES)
if(NOT "Salts::TLS" IN_LIST _crypto_provider_links)
  message(FATAL_ERROR "Salts::CryptoProvider must resolve the same Salts::TLS imported image")
endif()
unset(_crypto_provider_kind)
unset(_crypto_provider_links)
check_required_components(Crypto)
