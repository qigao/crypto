@PACKAGE_INIT@
# One provider image and one canonical Salts:: namespace; no aliases.
get_property(_salts_tls_owner GLOBAL PROPERTY SALTS_TLS_PACKAGE_OWNER)
if(TARGET Salts::TLS AND NOT _salts_tls_owner STREQUAL "${CMAKE_CURRENT_LIST_DIR}")
  message(FATAL_ERROR "Salts::TLS already belongs to another package; duplicate native crypto owner forbidden")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CryptoTLSTargets.cmake")
set_property(GLOBAL PROPERTY SALTS_TLS_PACKAGE_OWNER "${CMAKE_CURRENT_LIST_DIR}")
foreach(_salts_crypto_target IN ITEMS TLS CryptoProvider TLSHost TLSCipherBIO)
  if(NOT TARGET "Salts::${_salts_crypto_target}")
    message(FATAL_ERROR "Installed CryptoTLS missing canonical Salts::${_salts_crypto_target}")
  endif()
endforeach()
unset(_salts_tls_owner)
unset(_salts_crypto_target)
check_required_components(CryptoTLS)
